{
  "name": "@omercnet/paseo-beads",
  "version": "0.2.0",
  "type": "module",
  "description": "A dependency-aware Beads work queue for each Paseo workspace.",
  "license": "MIT",
  "author": "Omer Cohen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omercnet/paseo-plugins.git",
    "directory": "paseo-beads"
  },
  "homepage": "https://github.com/omercnet/paseo-plugins/tree/main/paseo-beads#readme",
  "bugs": {
    "url": "https://github.com/omercnet/paseo-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "beads",
    "local-first",
    "issue-tracking",
    "coding-agents"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "index.client.tsx",
    "index.server.ts",
    "client",
    "server",
    "shared",
    "paseo-plugin.json"
  ],
  "scripts": {
    "check": "biome check --error-on-warnings .",
    "check:write": "biome check --write .",
    "test": "run-s test:ci:*",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.thresholds.lines=90 --coverage.thresholds.functions=85",
    "typecheck": "tsc --noEmit",
    "package:release": "node scripts/package-release.ts",
    "verify:package": "node scripts/verify-package.ts",
    "build": "node ../.github/scripts/build-plugin.mjs",
    "test:ci:unit": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@getpaseo/cli": "0.9.0-beta.1",
    "@getpaseo/client": "0.9.0-beta.1",
    "@getpaseo/plugin": "0.9.0-beta.1",
    "@getpaseo/protocol": "0.9.0-beta.1",
    "@getpaseo/server": "0.9.0-beta.1",
    "@tanstack/react-query": "^5.102.3",
    "@types/node": "^24.5.2",
    "@types/react": "~19.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "fflate": "^0.8.3",
    "npm-run-all2": "^9.0.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0",
    "zod": "^4.4.3"
  }
}
