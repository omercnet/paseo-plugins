{
  "name": "@omercnet/paseo-dracula",
  "version": "1.0.0",
  "type": "module",
  "description": "Dracula Classic and Alucard Classic themes for Paseo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omercnet/paseo-plugins.git",
    "directory": "paseo-dracula"
  },
  "homepage": "https://github.com/omercnet/paseo-plugins/tree/main/paseo-dracula#readme",
  "bugs": {
    "url": "https://github.com/omercnet/paseo-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "author": "Omer Cohen",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "dracula",
    "theme",
    "color-scheme"
  ],
  "files": [
    "index.client.ts",
    "paseo-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.thresholds.lines=90 --coverage.thresholds.functions=85",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@getpaseo/client": "catalog:",
    "@getpaseo/plugin": "catalog:",
    "@getpaseo/protocol": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fflate": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
