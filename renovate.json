{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>omercnet/renovate-config"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bun catalog in the root package.json, which the bun and npm managers do not read",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": ["\"catalog\":\\s*\\{[^}]*\\}", "\"(?<depName>[^\"]+)\":\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "agent-browser version pins that must match paseo-shared-browser/package.json",
      "managerFilePatterns": [
        "/^paseo-shared-browser/README\\.md$/",
        "/^paseo-shared-browser/scripts/prepare-runtime\\.mjs$/",
        "/^paseo-shared-browser/server/agent-browser-runtime\\.ts$/",
        "/^paseo-shared-browser/server/runtime-(launch-environment|video-opt-in)\\.test\\.ts$/"
      ],
      "matchStrings": [
        "AGENT_BROWSER_VERSION = \"(?<currentValue>[^\"]+)\"",
        "expectedVersion = \"(?<currentValue>[^\"]+)\"",
        "`agent-browser` version `(?<currentValue>[^`]+)`",
        "\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\\n\""
      ],
      "depNameTemplate": "agent-browser",
      "depTypeTemplate": "dependencies",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Keep Paseo packages on the same release",
      "matchPackageNames": ["/^@getpaseo\\//"],
      "groupName": "Paseo"
    },
    {
      "description": "Keep OMP SDK packages on the same release",
      "matchPackageNames": ["/^@oh-my-pi\\//"],
      "groupName": "OMP SDK"
    },
    {
      "description": "The Paseo app provides React and React Native; the catalog pins its versions",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["react", "react-native"],
      "enabled": false
    }
  ]
}
