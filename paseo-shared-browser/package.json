{
  "name": "@omercnet/paseo-shared-browser",
  "version": "0.2.1",
  "private": true,
  "description": "One real Chromium session per Paseo workspace, shared live across every connected client.",
  "keywords": [
    "browser",
    "chromium",
    "coding-agents",
    "paseo",
    "paseo-plugin",
    "remote-browser"
  ],
  "license": "MIT",
  "author": "Omer Cohen",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt . '!CHANGELOG.md'",
    "format:check": "oxfmt --check . '!CHANGELOG.md'",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test:unit": "vitest run tests/contracts.test.ts tests/lease.test.ts",
    "test:smoke": "vitest run tests/browser.smoke.test.ts --testTimeout=30000"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.8.0-beta.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^20.9.0",
    "@types/react": "~19.2.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
