{
  "name": "@omercnet/paseo-shared-browser",
  "version": "1.0.0",
  "description": "One real Chromium session per Paseo workspace, shared live across every connected client.",
  "keywords": [
    "browser",
    "chromium",
    "coding-agents",
    "paseo",
    "paseo-plugin",
    "remote-browser"
  ],
  "homepage": "https://github.com/omercnet/paseo-plugins/tree/main/paseo-shared-browser#readme",
  "bugs": {
    "url": "https://github.com/omercnet/paseo-plugins/issues"
  },
  "license": "MIT",
  "author": "Omer Cohen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omercnet/paseo-plugins.git",
    "directory": "paseo-shared-browser"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.client.tsx",
    "index.server.ts",
    "client",
    "scripts/prepare-dependencies.mjs",
    "scripts/prepare-runtime.mjs",
    "server",
    "shared",
    "paseo-plugin.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test": "vitest run tests/contracts.test.ts tests/lease.test.ts tests/runtime-lifecycle.test.ts tests/agent-access.test.ts tests/composer-pills.test.ts",
    "test:unit": "vitest run tests/contracts.test.ts tests/lease.test.ts tests/runtime-lifecycle.test.ts tests/agent-access.test.ts tests/composer-pills.test.ts",
    "test:smoke": "vitest run tests/browser.smoke.test.ts --testTimeout=30000"
  },
  "dependencies": {
    "@getpaseo/plugin": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "agent-browser": "0.37.1",
    "esbuild": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "allowScripts": {
    "agent-browser": true,
    "esbuild@0.28.2": true
  }
}
