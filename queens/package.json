{
  "name": "@omercnet/paseo-queens",
  "version": "1.0.0",
  "type": "module",
  "description": "A cross-platform Queens logic puzzle for Paseo.",
  "license": "MIT",
  "author": "Omer Cohen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omercnet/paseo-plugins.git",
    "directory": "queens"
  },
  "homepage": "https://github.com/omercnet/paseo-plugins/tree/main/queens#readme",
  "bugs": {
    "url": "https://github.com/omercnet/paseo-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "queens",
    "logic-puzzle",
    "game"
  ],
  "files": [
    "index.client.tsx",
    "index.server.ts",
    "client",
    "shared",
    "server",
    "scripts",
    "paseo-plugin.json"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "import:puzzles": "node scripts/import-curated-puzzles.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "npm pack --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@getpaseo/plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
