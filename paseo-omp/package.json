{
  "name": "@omercnet/paseo-omp",
  "version": "0.4.0",
  "type": "module",
  "description": "Paseo integration for OMP, including its direct provider and workspace tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omercnet/paseo-plugins.git",
    "directory": "paseo-omp"
  },
  "homepage": "https://github.com/omercnet/paseo-plugins/tree/main/paseo-omp#readme",
  "bugs": {
    "url": "https://github.com/omercnet/paseo-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "Omer Cohen",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "paseo-omp",
    "omp",
    "coding-agents"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "scripts/prepare-dependencies.mjs",
    "index.client.tsx",
    "index.server.ts",
    "client",
    "server",
    "shared",
    "paseo-plugin.json"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "PASEO_OMP_COVERAGE=1 vitest run --coverage",
    "test:integration:docker": "node --import tsx scripts/test-docker-host-tools.ts",
    "test:integration:wsl": "node --import tsx scripts/test-wsl-host-tools.ts",
    "test:integration:canary": "node --import tsx scripts/test-canary.ts",
    "test:integration:install": "node --import tsx scripts/test-package-install.ts",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@getpaseo/protocol": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@getpaseo/cli": "catalog:",
    "@getpaseo/client": "catalog:",
    "@getpaseo/plugin": "catalog:",
    "@getpaseo/server": "catalog:",
    "@oh-my-pi/pi-agent-core": "18.2.0",
    "@oh-my-pi/pi-coding-agent": "18.2.0",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "pino": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
