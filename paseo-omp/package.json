{
  "name": "@omercnet/paseo-omp",
  "version": "0.0.0",
  "type": "module",
  "description": "Paseo integration for OMP, including a canary direct provider and workspace tooling.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "author": "Omer Cohen",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "paseo-omp",
    "omp",
    "coding-agents"
  ],
  "files": [
    "index.client.tsx",
    "index.server.ts",
    "client",
    "server",
    "shared",
    "paseo-plugin.json",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "bun test",
    "package:release": "bun scripts/package-release.ts",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@getpaseo/cli": "0.8.0",
    "@getpaseo/client": "0.8.0",
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/protocol": "0.8.0",
    "@tanstack/react-query": "^5.102.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
